CREATE DATABASE IF NOT EXISTS petshop_db;
USE petshop_db;

CREATE TABLE IF NOT EXISTS users (
  id INT(11) NOT NULL AUTO_INCREMENT,
  role VARCHAR(50) NOT NULL DEFAULT 'User',
  account_status ENUM('Active', 'Suspended') NOT NULL DEFAULT 'Active',
  username VARCHAR(100) NULL,
  surname VARCHAR(100) NULL,
  first_name VARCHAR(100) NULL,
  middle_initial VARCHAR(2) NULL,
  phone_number VARCHAR(20) NULL,
  email VARCHAR(150) NOT NULL,
  email_verified_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  password VARCHAR(255) NOT NULL,
  failed_attempts INT(11) DEFAULT 0,
  lockout_time DATETIME DEFAULT NULL,
  reset_token VARCHAR(255) DEFAULT NULL,
  reset_expires DATETIME DEFAULT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_users_username (username),
  UNIQUE KEY uq_users_email (email)
);

CREATE TABLE IF NOT EXISTS pending_registrations (
  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  surname VARCHAR(100) NOT NULL,
  first_name VARCHAR(100) NOT NULL,
  middle_initial VARCHAR(2) DEFAULT NULL,
  phone_number VARCHAR(20) NOT NULL,
  email VARCHAR(150) NOT NULL,
  password_hash VARCHAR(255) NOT NULL,
  otp_hash VARCHAR(255) NOT NULL,
  otp_expires_at DATETIME NOT NULL,
  last_sent_at DATETIME NOT NULL,
  attempts TINYINT UNSIGNED NOT NULL DEFAULT 0,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  KEY idx_pending_registrations_name (surname, first_name),
  KEY idx_pending_registrations_email (email),
  KEY idx_pending_registrations_expires (otp_expires_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE IF NOT EXISTS customers (
  id INT(11) NOT NULL AUTO_INCREMENT,
  customer_name VARCHAR(150) NOT NULL,
  email VARCHAR(150) DEFAULT NULL,
  phone VARCHAR(50) NOT NULL,
  address TEXT DEFAULT NULL,
  photo_path VARCHAR(255) DEFAULT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS pets (
  id INT(11) NOT NULL AUTO_INCREMENT,
  customer_id INT(11) NOT NULL,
  pet_name VARCHAR(100) NOT NULL,
  breed VARCHAR(100) DEFAULT NULL,
  species VARCHAR(50) DEFAULT NULL,
  photo_path VARCHAR(255) DEFAULT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  CONSTRAINT fk_pets_customer FOREIGN KEY (customer_id) REFERENCES customers(id)
);

CREATE TABLE IF NOT EXISTS products (
    product_id INT AUTO_INCREMENT PRIMARY KEY,
    sku VARCHAR(40) UNIQUE,
    product_name VARCHAR(150) NOT NULL,
    category VARCHAR(100) NOT NULL,
    product_group ENUM('Food', 'Shampoo', 'Other') NOT NULL DEFAULT 'Other',
    price DECIMAL(10, 2) NOT NULL,
    stock_quantity INT UNSIGNED NOT NULL DEFAULT 0,
    reorder_level INT UNSIGNED NOT NULL DEFAULT 5,
    is_active TINYINT(1) NOT NULL DEFAULT 1,
    description TEXT,
    image VARCHAR(255),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE grooming_services (
    service_id INT AUTO_INCREMENT PRIMARY KEY,
    service_name VARCHAR(100) NOT NULL,
    description TEXT,
    price DECIMAL(10,2) NOT NULL,
    status VARCHAR(20) DEFAULT 'Available'
);


CREATE TABLE haircut_styles (
    style_id INT AUTO_INCREMENT PRIMARY KEY,
    style_name VARCHAR(100) NOT NULL,
    description TEXT,
    price DECIMAL(10,2) NOT NULL,
    status VARCHAR(20) DEFAULT 'Available'
);


CREATE TABLE user_activity_logs (
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    page_name VARCHAR(150) NOT NULL,
    visited_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    action_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

