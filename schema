USE petshop_db;

-- 1. Styles & Packages Table (e.g., Shaved/Kalbo, Summer Cut, Bear Cut, etc.)
CREATE TABLE IF NOT EXISTS grooming_styles (
    style_id INT AUTO_INCREMENT PRIMARY KEY,
    style_name VARCHAR(100) NOT NULL
) ENGINE=InnoDB;

-- 2. Size Pricing Table (Links styles with pet sizes and specific prices)
CREATE TABLE IF NOT EXISTS style_size_pricing (
    pricing_id INT AUTO_INCREMENT PRIMARY KEY,
    style_id INT NOT NULL,
    pet_size VARCHAR(50) NOT NULL, -- 'Small', 'Medium', 'Large', 'Extra Large', 'Giant'
    price DECIMAL(10,2) NOT NULL,
    FOREIGN KEY (style_id) REFERENCES grooming_styles(style_id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- 3. Add-ons Table (e.g., Basic Sanitary, Only Nails, etc.)
CREATE TABLE IF NOT EXISTS grooming_addons (
    addon_id INT AUTO_INCREMENT PRIMARY KEY,
    addon_name VARCHAR(100) NOT NULL,
    price DECIMAL(10,2) NOT NULL
) ENGINE=InnoDB;

